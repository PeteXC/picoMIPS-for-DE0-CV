// sample picoMIPS program
// n = 8 bits, Isize = 11+n = 19 bits
// format: 3b opcode, 4b %d, 4b %s or 8b immediate or address
//
// HEX /////////// BINARY  ///////////////////// ASSEMBLER /////////
0005    // 15'b000_0000_0000_0101   LDI
0103    // 15'b000_0001_0000_0011   LDI
2E10    // 15'b010_1110_0001_0000   ADD
3005    // 15'b011_0000_0000_0101   ADDI
0209    // 15'b000_0010_0000_1001   LDI
0302    // 15'b000_0011_0000_0010   LDI
4F23    // 15'b100_1111_0010_0011   MUL
5209    // 15'b101_0010_0000_1001   MULI

// We are looking for registers to be:
// gpr[0] : 00001101
// gpr[1] : 00001000
// gpr[2] : 10100010
// gpr[3] : 00010010








