// sample picoMIPS program
// n = 8 bits, Isize = 11+n = 19 bits
// format: 3b opcode, 4b %d, 4b %s, 8b immediate or address
//
// HEX /////////// BINARY  ///////////////////// ASSEMBLER /////////
00005    // 19'b000_0000_0000_0000_0101   LDI
01003    // 19'b000_0001_0000_0000_0011   LDI
21000    // 19'b010_0001_0000_0000_0000   ADD
30105    // 19'b011_0000_0001_0000_0101   ADDI
02009    // 19'b000_0010_0000_0000_1001   LDI
03002    // 19'b000_0011_0000_0000_0010   LDI
43200    // 19'b100_0011_0010_0000_0000   MUL
52309    // 19'b101_0010_0011_0000_1001   MULI

// We are looking for registers to be:
// gpr[0] : 00001101
// gpr[1] : 00001000
// gpr[2] : 10100010
// gpr[3] : 00010010








