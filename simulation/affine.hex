// Affine Transformation picoMIPS program
// n = 8 bits, Isize = 11+n = 19 bits
// format: 3b opcode, 4b %d, 4b %s, 8b immediate or address
//
// HEX /////////// BINARY  ///////////////////// ASSEMBLER /////////
//7000    // 19'b111_0000_0000_0000   WAIT1
//1000    // 19'b001_0000_0000_0000   LDS
//6000    // 19'b110_0000_0000_0000   WAIT0
//7000    // 19'b111_0000_0000_0000   WAIT1
//1100    // 19'b001_0001_0000_0000   LDS
//6000    // 19'b110_0000_0000_0000   WAIT0
//0260    // 19'b000_0010_0110_0000   LDI (Load 0.75)
//0340    // 19'b000_0011_0100_0000   LDI (Load 0.5)
//4402    // 19'b100_0100_0000_0010   MUL (0.75 a11*x1)
//4513    // 19'b100_0101_0001_0011   MUL (0.5 a12*y1)
//2E54    // 19'b010_1110_0101_0100   ADD (a11*x1 + a12*y1)
//3E14    // 19'b011_1110_0001_0100   ADDI (a11*x1 + a12*y1 + B) ANS
//50C0    // 19'b101_0000_1100_0000   MULI (-0.5 a21*x1)
//5160    // 19'b101_0001_0110_0000   MULI (0.75 a22*y1)
//2F01    // 19'b010_1111_0000_0001   ADD (a21*x1 + a22*y1)
//3FEC    // 19'b011_1111_1110_1100   ADDI (a21*x1 + a22*y1 + B) ANS
//7000    // 19'b111_0000_0000_0000   WAIT1 to display x2
//6000    // 19'b110_0000_0000_0000   WAIT0 to display x1
1C00    // 19'b111_00_0000_0000   WAIT1
0400    // 19'b001_00_0000_0000   LDS
1800    // 19'b110_00_0000_0000   WAIT0
1C00    // 19'b111_00_0000_0000   WAIT1
0500    // 19'b001_01_0000_0000   LDS
1800    // 19'b110_00_0000_0000   WAIT0
0260    // 19'b000_10_0110_0000   LDI (Load 0.75)
0340    // 19'b000_11_0100_0000   LDI (Load 0.5)
1202    // 19'b100_10_0000_0010   MUL (0.75 a11*x1)
1313    // 19'b100_11_0001_0011   MUL (0.5 a12*y1)
0A32    // 19'b010_10_0011_0010   ADD (a11*x1 + a12*y1)
0E14    // 19'b011_10_0001_0100   ADDI (a11*x1 + a12*y1 + B) ANS
14C0    // 19'b101_00_1100_0000   MULI (-0.5 a21*x1)
1560    // 19'b101_01_0110_0000   MULI (0.75 a22*y1)
0B01    // 19'b010_11_0000_0001   ADD (a21*x1 + a22*y1)
0FEC    // 19'b011_11_1110_1100   ADDI (a21*x1 + a22*y1 + B) ANS
1C00    // 19'b111_00_0000_0000   WAIT1 to display x2
1800    // 19'b110_00_0000_0000   WAIT0 to display x1






// We are looking for registers to be:
// gpr[14] : 11010100 (45) x2 [ACTUAL: 45.5]
// gpr[15] : 11111110 (-2) y2 [ACTUAL: -1.25]

// Algorithm always goes to floor of number, because you take the top 8 bits.