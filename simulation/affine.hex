// Affine Transformation picoMIPS program
// n = 8 bits, Isize = 11+n = 19 bits
// format: 3b opcode, 4b %d, 4b %s, 8b immediate or address
//
// HEX /////////// BINARY  ///////////////////// ASSEMBLER /////////
7000    // 19'b111_0000_0000_0000   WAIT1
1000    // 19'b001_0000_0000_0000   LDS
6000    // 19'b110_0000_0000_0000   WAIT0
7000    // 19'b111_0000_0000_0000   WAIT1
1100    // 19'b001_0001_0000_0000   LDS
6000    // 19'b110_0000_0000_0000   WAIT0
0260    // 19'b000_0010_0110_0000   LDI (Load 0.75)
0340    // 19'b000_0011_0100_0000   LDI (Load 0.5)
4402    // 19'b100_0100_0000_0010   MUL (0.75 a11*x1)
4513    // 19'b100_0101_0001_0011   MUL (0.5 a12*y1)
2E54    // 19'b010_1110_0101_0100   ADD (a11*x1 + a12*y1)
3E14    // 19'b011_1110_0001_0100   ADDI (a11*x1 + a12*y1 + B) ANS
50C0    // 19'b101_0000_1100_0000   MULI (-0.5 a21*x1)
5160    // 19'b101_0001_0110_0000   MULI (0.75 a22*y1)
2F01    // 19'b010_1111_0000_0001   ADD (a21*x1 + a22*y1)
3FEC    // 19'b011_1111_1110_1100   ADDI (a21*x1 + a22*y1 + B) ANS
7000    // 19'b111_0000_0000_0000   WAIT1 to display x2
6000    // 19'b110_0000_0000_0000   WAIT0 to display x1






