// sample picoMIPS program
// n = 8 bits, Isize = 11+n = 19 bits
// format: 3b opcode, 4b %d, 4b %s, 8b immediate or address
//
// HEX /////////// BINARY  ///////////////////// ASSEMBLER /////////
000_0000_0000_00000101   //LDI
000_0001_0000_00000011   //LDI
010_0001_0000_00000000   //ADD
011_0000_0001_00000101   //ADDI
000_0010_0000_00001001   //LDI
000_0011_0000_00000010   //LDI
100_0011_0010_00000000   //MUL
101_0010_0011_00001001   //MULI








