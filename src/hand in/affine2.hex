// Affine Transformation picoMIPS program
// n = 8 bits, Isize = 5+n = 13 bits
// format: 3b opcode, 4b %dst, 4b %src1 + 4b %src2 OR 8b immediate
//
// HEX /////////// BINARY  ///////////////////// ASSEMBLER /////////
0260    // 13'b000_10_0110_0000   LDI (Load 0.75)
0340    // 13'b000_11_0100_0000   LDI (Load 0.5)
0400    // 13'b001_00_0000_0000   LDP into gpr[0]
0500    // 13'b001_01_0000_0000   LDP into gpr[1]
1202    // 13'b100_10_0000_0010   MUL (0.75 a11*x1)
1313    // 13'b100_11_0001_0011   MUL (0.5 a12*y1)
0A32    // 13'b010_10_0011_0010   ADD (a11*x1 + a12*y1)
0E14    // 13'b011_10_0001_0100   ADDI (a11*x1 + a12*y1 + B) ANS
14C0    // 13'b101_00_1100_0000   MULI (-0.5 a21*x1)
1560    // 13'b101_01_0110_0000   MULI (0.75 a22*y1)
0B01    // 13'b010_11_0000_0001   ADD (a21*x1 + a22*y1)
0FEC    // 13'b011_11_1110_1100   ADDI (a21*x1 + a22*y1 + B) ANS
0500    // 13'b001_01_0000_0000   LDP into gpr[1] to display





// We are looking for registers to be:
// gpr[14] : 00101101 (45) x2 [ACTUAL: 45.5]
// gpr[15] : 11111110 (-2) y2 [ACTUAL: -1.25]

// Algorithm always goes to floor of number, because you take the top 8 bits.